APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=5000

SECRET_KEY=change-me

MONGO_ENABLED=false
MONGO_URI=
MONGO_URI2=

SEARCH_ENABLED=false
USER_ROUTES_ENABLED=false
BACKEND_BUILD_TARGET=production
SEARCH_DEVICE=cpu
SEARCH_MODEL_CACHE_SIZE=1

GEMINI_API_KEY=
BEIT3_CHECKPOINT_PATH=/models/beit3_large_itc_patch16_224.pth
EMBEDDING_ROOT=/data/embeddings
METADATA_ROOT=/data/metadata
KEYFRAMES_PATH=/data/keyframes

QDRANT_URL=http://qdrant:6333

MONGO_SEARCH_ENABLED=false
MONGO_SEARCH_URI=
MONGO_SEARCH_DB=aic2026

MONGO_ROOT_USER=aicadmin
MONGO_ROOT_PASSWORD=

# TRAKE tầng 3 (tinh chỉnh frame gốc) - chỉ bật khi máy có sẵn video gốc (vd USB rời).
# Để trống/false -> tự động chạy case 2 (2 tầng, độ phân giải keyframe), không cần sửa code.
TRAKE_TIER3_ENABLED=false
VIDEO_ROOT=
# Ví dụ Windows: VIDEO_ROOT=E:\aic2026_videos
# Ví dụ Linux/WSL: VIDEO_ROOT=/mnt/d/aic2026_videos

TRAKE_TOP_M=150
TRAKE_TOP_VIDEOS=2
TRAKE_MAX_COMBOS=100
TRAKE_TIER3_RADIUS=15
TRAKE_TIER3_STRIDE=1
TRAKE_VIDEO_CONFIDENCE_THRESHOLD=0.8

# Rerank khoảnh khắc khi các frame gần tie (mặc định dùng thuật toán, miễn phí, luôn chạy).
# Qwen2.5-VL chạy LOCAL (transformers, giữ ấm trên GPU), quantize để giảm VRAM/RAM - KHÔNG dùng API.
TRAKE_RERANK_TIE_MARGIN=0.03
TRAKE_QWEN_RERANK_ENABLED=false
QWEN_MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct
# QWEN_QUANTIZATION: 4bit | 8bit | none. 4bit cho VRAM ~6-8GB (7B). Muốn dùng bản prequant
# AWQ/GPTQ thì trỏ QWEN_MODEL_PATH tới repo đó và đặt QWEN_QUANTIZATION=none.
QWEN_QUANTIZATION=4bit
QWEN_DEVICE_MAP=auto
QWEN_MAX_NEW_TOKENS=10
